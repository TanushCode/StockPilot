# StockPilot - Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env to git.

# ──────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key

# ──────────────────────────────────────────────
# Database (local development uses SQLite)
# ──────────────────────────────────────────────
# For local dev: leave DATABASE_URL blank to use SQLite
# For production: set USE_RDS=true and store creds in SSM Parameter Store
DATABASE_URL=
USE_RDS=false

# RDS settings (production only — stored in SSM Parameter Store)
# These are fallbacks if SSM is unavailable:
RDS_HOST=
RDS_PORT=3306
RDS_DATABASE=stockpilot
RDS_USERNAME=
RDS_PASSWORD=

# SSM Parameter paths (production)
SSM_DB_HOST=/stockpilot/db/host
SSM_DB_PORT=/stockpilot/db/port
SSM_DB_NAME=/stockpilot/db/name
SSM_DB_USERNAME=/stockpilot/db/username
SSM_DB_PASSWORD=/stockpilot/db/password

# ──────────────────────────────────────────────
# AWS (production — EC2 instance role preferred)
# ──────────────────────────────────────────────
AWS_REGION=ap-south-1

# S3
S3_BUCKET_NAME=stockpilot-uploads-CHANGE-ME
S3_PRESIGNED_EXPIRY=3600

# SQS
SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/ACCOUNT_ID/stockpilot-events

# SNS
SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:ACCOUNT_ID:stockpilot-alerts

# ──────────────────────────────────────────────
# Local development AWS mock settings
# ──────────────────────────────────────────────
USE_LOCAL_STORAGE=true
LOCAL_UPLOAD_DIR=./uploads
USE_LOCAL_QUEUE=true
USE_LOCAL_SNS=true
